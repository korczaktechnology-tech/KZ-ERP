aws_region = "sa-east-1"
ecr_repository = "kz-erp-api"
image_tag = "0.1.3"
postgres_version = "17.6"
db_instance_class = "db.t4g.medium"
db_username = "erp"
db_password = "replace-with-secret-manager-value"
mongodb_uri = "mongodb://replace"
mongodb_db = "ERP"
auth_secret = "replace-with-32-plus-character-secret"
core_bootstrap_key = "replace-with-32-plus-character-key"
cors_origin = "https://erp.example.com"
public_zone = "example.com"
api_domain = "api.example.com"
cdn_domain = "erp.example.com"
cloudfront_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/replace"
